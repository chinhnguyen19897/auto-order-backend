{
  "name": "auto-order-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "yarn install && yarn run setup && docker compose up -d --wait && yarn run db:migrate && yarn run db:seed && yarn run dev",
    "dev:local": "docker compose up -d --wait && yarn run dev",
    "dev": "npm run build && concurrently -k -n compiler,api,worker \"tsc --watch\" \"node --watch dist/main.js\" \"node --watch dist/worker.js\"",
    "worker:dev": "node --watch dist/worker.js",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "dev:watch": "concurrently -k \"tsc --watch\" \"node --watch dist/main.js\"",
    "setup": "node scripts/setup.mjs",
    "dev:api": "npm run build && npm run dev:watch",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "@payos/node": "^2.0.0",
    "bullmq": "^5.61.0",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0",
    "qrcode": "^1.5.4",
    "tiktok-live-connector": "^2.5.0"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "@types/node": "^22.12.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
