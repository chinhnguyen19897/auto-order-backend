# Copy with npm run setup. Generated secrets go in ignored files only.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://auto_order:auto_order@127.0.0.1:5432/auto_order?schema=public
REDIS_URL=redis://127.0.0.1:6379
WEB_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
TOKEN_ENCRYPTION_KEY=CHANGE_ME
INGEST_SECRET=CHANGE_ME
DEMO_MODE=true
PAYMENT_PROVIDER=demo
NOTIFICATION_PROVIDER=demo
# payOS production credentials (never NEXT_PUBLIC_*):
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Notification gateway must implement docs/INTEGRATIONS.md.
# Use your Zalo-approved template or SMS provider in that gateway.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Optional signing-service key for the unofficial TikTok connector:
TIKTOK_SIGN_API_KEY=
